## RENAME THIS FILE TO .env
# No need to change
COMPOSE_PROJECT_NAME=switchboarddocker
# TLS certificates email (public)
DEFAULT_EMAIL=myemail@mail.com
# Your domain or sub-domain name. localhost for dev (will use self signed certificates)
# For local :
VIRTUAL_HOST=localhost
#Or with a domain or sub-domain :
#VIRTUAL_HOST=sb.mydomain.com
# Set timezone find yours there second column : https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Database, use secure password, also modify the user and database name
MYSQL_ROOT_PASSWORD=complexrootpassword
MYSQL_DATABASE=dbname
MYSQL_USER=dbuser
MYSQL_PASSWORD=complexdbuserpassword

# Optional: leave empty. The SwitchBoard repository is public. A read-only GitHub token is only
# useful to follow a private copy of the repository, or to lift GitHub's limit on requests without a
# token (60 per hour per IP address) for the update check. A token that GitHub refuses is ignored.
# https://github.com/settings/tokens (fine-grained: read access to Contents and Metadata)
GITHUB_TOKEN=

# Encrypts stored secrets (voip.ms API password, SwitchBoard Chat/MAS tokens) at rest.
# Strongly recommended. Generate with: php -r "echo base64_encode(random_bytes(32));"
# Losing this key makes existing encrypted secrets unrecoverable - back it up with your
# database backups. Leave empty and these secrets stay stored in plaintext.
APP_ENCRYPTION_KEY=

# Only needed if your hosting can only trigger the src/*.php batch scripts via a URL
# instead of a real cron job. Leave empty (recommended): see Docker/cronjobs, which
# already runs them in the container via CLI cron, not the web.
CRON_WEB_KEY=

# Only needed if your SwitchBoard Chat / MAS server uses a SELF-SIGNED certificate.
# Otherwise leave both empty - TLS verification works on its own.
#
# RECOMMENDED: trust your self-signed certificate. TLS verification stays ON.
# 1. Save the certificate into the certs/ folder next to this file, e.g. from Docker/:
#      echo | openssl s_client -connect sbchat.mydomain.ca:3443 2>/dev/null \
#        | openssl x509 > certs/sbchat-cert.pem
# 2. Set the path AS SEEN FROM INSIDE THE CONTAINER (certs/ is mounted at /etc/ssl/sbchat),
#    NOT the path on the host:
#      SB_SBCHAT_CA_BUNDLE=/etc/ssl/sbchat/sbchat-cert.pem
SB_SBCHAT_CA_BUNDLE=

# LAST RESORT: set to 1 to disable TLS verification entirely for the SBChat/MAS
# connection. SBChat/MAS tokens travel over this connection, so without verification it
# is exposed to interception (MITM). Prefer SB_SBCHAT_CA_BUNDLE above.
SB_ALLOW_INSECURE_TLS=

# Mail: SwitchBoard uses this to report errors and warnings affecting call routing, so it
# matters that it actually works. Leave everything below empty and the app still starts
# fine, but you won't get notified of problems - test it from the admin console once
# running (Console d'administration -> Courriel de test) rather than guessing.
#
# Two ways to authenticate - pick ONE:
#
# 1) Simple password (SB_SMTP_PASSWORD below). Works with any SMTP relay that still
#    accepts a plain password. RECOMMENDED for that path: a Google account with an app
#    password (not your regular password): https://support.google.com/accounts/answer/185833
#    - use an account with some prior activity, a brand new one is more likely to get
#    flagged as spam. Google caps you at 500 emails/day, plenty for error notifications.
#    Some providers (e.g. Yandex) have been observed auto-flagging fresh accounts as spam,
#    and Microsoft 365 is actively phasing out plain passwords for SMTP - use option 2 for
#    Microsoft 365.
#
# 2) OAuth2 (SB_SMTP_OAUTH_* below), for Microsoft 365 or Google. Needed for Microsoft 365
#    tenants where plain SMTP passwords are disabled (increasingly the default). Requires a
#    one-time app registration in the provider's own console (Azure AD for Microsoft,
#    Google Cloud Console for Google) - see MAIL-OAUTH-SETUP.md for exact steps. Once
#    SB_SMTP_OAUTH_PROVIDER/CLIENT_ID (+ CLIENT_SECRET for Google) are set here, finish the
#    one-time authorization from the admin console (Console d'administration -> Courriel
#    OAuth) - after that, token refresh is fully automatic, nothing to maintain.
SB_SMTP_HOST=
# Leave empty for the default (587, STARTTLS; OAuth mode also defaults host/port per provider).
SB_SMTP_PORT=
SB_SMTP_USER=
# Option 1 only - leave empty if using OAuth (option 2) instead.
SB_SMTP_PASSWORD=
# Leave empty to default to SB_SMTP_USER.
SB_SMTP_FROM=
# Leave empty for the default (on). Set to off only if your relay truly doesn't support TLS.
SB_SMTP_TLS=

# Option 2 (OAuth2) only - see MAIL-OAUTH-SETUP.md. Leave all of these empty for option 1.
# "microsoft365" or "google" - leave empty for the simple password path (option 1) above.
SB_SMTP_OAUTH_PROVIDER=
# The "Application (client) ID" from your app registration. Required for both providers.
SB_SMTP_OAUTH_CLIENT_ID=
# Google only - Microsoft's device code flow needs no secret. Leave empty for Microsoft 365.
SB_SMTP_OAUTH_CLIENT_SECRET=
# Microsoft 365 only. Leave empty for the default ("common", works for most tenants).
SB_SMTP_OAUTH_TENANT=

# Monitoring (dead-man's-switch): SwitchBoard pings an external heartbeat service (e.g. the
# free healthchecks.io) after checking its own health, so you (and other admins) get alerted
# even if this container is hung or the whole host is down - see DEADMANSWITCH-SETUP.md.
# Leave all of these empty and configure it instead from the admin console (Console
# d'administration -> Surveillance (dead-man's-switch)) - same self-service pattern as the
# mail OAuth wizard above. Only fill these in .env if you'd rather manage it outside the UI.
SB_DMS_RINGGROUP_SUCCESS_URL=
SB_DMS_RINGGROUP_FAIL_URL=
SB_DMS_SBCHAT_SUCCESS_URL=
SB_DMS_SBCHAT_FAIL_URL=
SB_DMS_MAIL_SUCCESS_URL=
SB_DMS_MAIL_FAIL_URL=
# Optional: where mailcanary.php sends its periodic test email. Leave empty to use the
# account's own admin address (avoids inbox clutter if you'd rather use a dedicated test
# mailbox instead).
SB_DMS_MAIL_TEST_RECIPIENT=
SB_DMS_INFRA_SUCCESS_URL=
SB_DMS_INFRA_FAIL_URL=
# Optional thresholds for the disk-space check (checkinfra.php). Defaults: 10% and 1 GB.
SB_DMS_INFRA_DISK_MIN_PERCENT=
SB_DMS_INFRA_DISK_MIN_GB=
